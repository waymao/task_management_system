generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks                  Task[]
  projects               Project[]
  assignments            Assignment[]
  googleCalendarAccounts GoogleCalendarAccount[]

  @@index([email])
  @@map("users")
}

model Task {
  id           String    @id @default(uuid())
  title        String
  description  String?
  type         String    // 'todo' | 'delegated' | 'immediate'
  status       String    @default("pending") // 'pending' | 'completed' | 'cancelled'
  priority     String    @default("medium") // 'low' | 'medium' | 'high'
  dueDate      DateTime?
  delegatedTo  String?
  followUpDate DateTime?
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignments  Assignment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([userId, status])
  @@index([userId, type])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("tasks")
}

model Assignment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  slot      String   // 'allday' | 'morning' | 'afternoon' | 'evening'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, date, slot])
  @@index([userId, date])
  @@map("assignments")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String?  @default("#3b82f6")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String?
  contentType String   @default("tasks_only") // 'tasks_only' | 'notes' | 'mixed'
  metadata    String?  // JSON string for extensibility
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("projects")
}

model GoogleCalendarAccount {
  id           String                      @id @default(uuid())
  userId       String
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  refreshToken String
  accessToken  String
  expiresAt    DateTime
  events       GoogleCalendarEvent[]
  calendars    GoogleCalendarPreference[]
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@unique([userId, email])
  @@index([userId])
  @@map("google_calendar_accounts")
}

model GoogleCalendarPreference {
  id           String                @id @default(uuid())
  accountId    String
  account      GoogleCalendarAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  calendarId   String
  calendarName String
  enabled      Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([accountId, calendarId])
  @@index([accountId, enabled])
  @@map("google_calendar_preferences")
}

model GoogleCalendarEvent {
  id        String                @id @default(uuid())
  accountId String
  account   GoogleCalendarAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  eventId   String
  title     String
  startTime DateTime
  endTime   DateTime
  isAllDay  Boolean               @default(false)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([accountId, eventId])
  @@index([accountId, startTime])
  @@index([accountId, endTime])
  @@index([accountId, startTime, endTime])
  @@map("google_calendar_events")
}
